# Configuration de tsl-sync — à copier dans /etc/tsl-sync.conf (chmod 600)

# --- Nextcloud ---------------------------------------------------------------
# Adresse de ton Nextcloud (sans /remote.php...)
NC_URL="https://cloud.exemple.fr"
# Ton identifiant Nextcloud
NC_USER="moi"
# Mot de passe d'APPLICATION (Nextcloud > Paramètres > Sécurité > "Créer un mot de passe d'application")
NC_PASS="xxxxx-xxxxx-xxxxx-xxxxx-xxxxx"
# Dossier de destination dans ton Nextcloud
NC_DIR="Geometry Dash/TSL"

# --- Options -----------------------------------------------------------------
# Listes à suivre (noms utilisés dans https://tsl.pages.dev/list/<nom>)
LISTS="tsl tslplus"
# Copie locale des fichiers et de l'état
DATA_DIR="/var/lib/tsl-sync"
# Pause entre deux requêtes aux serveurs Geometry Dash (secondes) — évite le blocage
DELAY=3
# 1 = tout envoyer dans Nextcloud à la fin du passage (par défaut) ; 0 = au fur et à mesure
UPLOAD_AT_END=1
# 1 = créer chaque jour un dossier AAAA-MM-JJ dans Nextcloud avec les niveaux nouveaux/modifiés ce jour-là
DAILY=1

# --- Discord ------------------------------------------------------------------
# Bot (recommandé) : annonces + commandes /niveau /changements /liste /statut /verifier
#   1. https://discord.com/developers/applications > New Application > Bot > Reset Token
#   2. OAuth2 > URL Generator : cocher "bot" + "applications.commands",
#      permissions "Send Messages", "Embed Links", "Attach Files" > ouvrir le lien pour l'inviter
#   3. Discord > Paramètres > Avancés > Mode développeur, puis clic droit sur le salon > Copier l'identifiant
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
# (optionnel) identifiant de ton serveur Discord : les commandes apparaissent immédiatement
DISCORD_GUILD_ID=""
# Alternative sans bot : URL d'un webhook Discord (annonces seulement)
DISCORD_WEBHOOK=""
# 1 = publier aussi un message quand rien n'a changé
DISCORD_ALWAYS=0
