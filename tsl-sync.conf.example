# tsl-sync configuration — copy to /etc/tsl-sync.conf (chmod 600)

# --- Nextcloud ----------------------------------------------------------------
# Address of your Nextcloud (without /remote.php...)
NC_URL="https://cloud.example.com"
# Your Nextcloud username
NC_USER="me"
# APP password (Nextcloud > Settings > Security > "Create new app password")
NC_PASS="xxxxx-xxxxx-xxxxx-xxxxx-xxxxx"
# Destination folder in your Nextcloud
NC_DIR="Geometry Dash/TSL"

# --- Options ------------------------------------------------------------------
# Lists to follow (names used in https://tsl.pages.dev/list/<name>)
LISTS="tsl tslplus"
# Local copy of the files and of the state
DATA_DIR="/var/lib/tsl-sync"
# Pause between two requests to the Geometry Dash servers (seconds) — avoids being blocked
DELAY=3
# 1 = upload everything to Nextcloud at the end of the run (default); 0 = as we go
UPLOAD_AT_END=1
# 1 = create a YYYY-MM-DD folder in Nextcloud every day with the levels new/changed that day
DAILY=1

# --- Discord ------------------------------------------------------------------
# Bot (recommended): announcements + /level /changes /list /status /check commands
#   1. https://discord.com/developers/applications > New Application > Bot > Reset Token
#   2. OAuth2 > URL Generator: tick "bot" + "applications.commands",
#      permissions "Send Messages", "Embed Links", "Attach Files" > open the link to invite it
#   3. Discord > Settings > Advanced > Developer Mode, then right-click the channel > Copy Channel ID
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
# (optional) ID of your Discord server: commands show up immediately
DISCORD_GUILD_ID=""
# Alternative without a bot: Discord webhook URL (announcements only)
DISCORD_WEBHOOK=""
# 1 = also post a message at the end of a run when nothing changed (0 = only when something changed)
DISCORD_ALWAYS=1
