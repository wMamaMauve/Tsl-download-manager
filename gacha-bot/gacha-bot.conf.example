# gacha-bot configuration — copy to /etc/gacha-bot.conf (chmod 600)

# --- Discord ------------------------------------------------------------------
# A second bot: https://discord.com/developers/applications > New Application > Bot > Reset Token
# OAuth2 > URL Generator: "bot" + "applications.commands", permissions "Send Messages" + "Embed Links"
DISCORD_BOT_TOKEN=""
# (optional) ID of your Discord server: the commands show up immediately
DISCORD_GUILD_ID=""
# (optional) channel ID where the bot warns when its session is about to expire
DISCORD_CHANNEL_ID=""

# --- Extreme Demon Gacha ------------------------------------------------------
# The account the bot reads the collections with (made for this, with the site owner's agreement).
# It only reads: it never opens packs, trades or plays.
# Session cookie of that account (accounts that log in with Discord). On a computer:
#   log in on demongacha.com with the bot's account > F12 > Application (Chrome) or Storage (Firefox)
#   > Cookies > https://demongacha.com > copy the value of "sid".
# It lasts 30 days: the bot warns in DISCORD_CHANNEL_ID a few days before, then put the new one here.
GACHA_SID=""
# (or, for an account that has a password)
GACHA_USERNAME=""
GACHA_PASSWORD=""
# Clan whose members are followed (its tag)
GACHA_CLAN="TSL"

# --- Options ------------------------------------------------------------------
# Quick refresh every N minutes: 1 request per member, and only the collections that changed are read
# again (0 = only the daily refresh)
REFRESH_MINUTES=15
# Full refresh of every collection once a day, around this hour (server time)
SYNC_HOUR=5
# Pause between two requests to the site (seconds)
REQUEST_DELAY=1
DATA_DIR="/var/lib/gacha-bot"
